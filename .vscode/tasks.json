{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start OneNote web server",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "onenote_indexer.webapp",
        "--host",
        "127.0.0.1",
        "--port",
        "8765"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "onenote-indexer",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting OneNote PDF Indexer web server",
          "endsPattern": "Serving OneNote PDF Indexer"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}

